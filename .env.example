# Optional. Null works FULLY without a key (deterministic grammar parser).
# If set, the plain-English parser and the autopsy follow-up are phrased by Claude.
#
# WARNING: a VITE_ variable is embedded in the client bundle at build time and is
# therefore PUBLIC. Do NOT put a secret key here for a public deployment — instead
# let each user paste their own key in the app (stored only in their browser).
# This var is intended for LOCAL development only.
VITE_ANTHROPIC_API_KEY=

# ── AI for the deployed demo: server-side proxy (no key in the browser) ──────
# The recommended production path. Set the SECRET below in your host's dashboard
# (Netlify/Vercel env), NOT in a committed file — it is read server-side by the
# serverless proxy (api/anthropic.js · netlify/functions/anthropic.mjs) and is
# never shipped to the client. Note: NO "VITE_" prefix, so it is never bundled.
ANTHROPIC_API_KEY=

# The public path the browser POSTs AI requests to (the serverless proxy). This
# is just a path, not a secret. Set by netlify.toml / vercel.json for deploys;
# for a local `netlify dev` / `vercel dev` you can set it here.
#   Netlify: /.netlify/functions/anthropic     Vercel: /api/anthropic
VITE_AI_PROXY_URL=

# ── Optional, privacy-respecting telemetry (all OFF unless set) ──────────────
# None of these are secrets. VITE_* values are PUBLIC in the client bundle — that
# is fine here: a Plausible domain and an error-beacon URL are not credentials.

# Enables cookieless Plausible analytics for this domain (no PII, no cookies).
# Leave blank to disable analytics entirely.
VITE_PLAUSIBLE_DOMAIN=
# Optional: self-hosted Plausible origin (defaults to https://plausible.io).
VITE_PLAUSIBLE_HOST=

# Optional: a URL that receives a coarse, non-PII JSON error beacon. Leave blank
# to keep errors in the console + the visible in-app fallback only.
VITE_ERROR_ENDPOINT=
